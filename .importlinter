# Import contracts for the `fsm_llm` package, run by `make lint-imports`
# (`lint-imports`, from import-linter; the engine is grimp).
#
# Plan d454fd62, step 61 (and 65: reasoning): only the contracts that hold on today's layout
# (source in `src/fsm_llm/`, imported as `fsm_llm`). Step 95 activates the layered
# Section 5.2 contract (D-016) once the packages it names exist; every move
# step (65 to 94) extends this file for the packages it places. A contract is
# never weakened to pass: a debt is an `ignore_imports` line that names the row
# retiring it (`# retired by: <row>`) or the written reason it stays
# (`# permanent: <reason>`). import-linter fails on an ignore that matches no
# import, so a stale entry is caught.
#
# No `forbidden` contract here uses `allow_indirect_imports`: a chain through
# another module counts, so a re-export cannot launder an import.
#
# Source `fsm_llm.*` (every direct child, so a new module is covered with no
# edit) is used where the forbidden module is itself inside `fsm_llm`: with the
# bare root as source import-linter treats the forbidden module as part of the
# source and reports nothing (measured at step 61: a planted import was missed).
# The root `fsm_llm/__init__.py` is not a child: `TestPackageInitImportsNoSubpackage`
# in tests/test_packaging.py covers it.

[importlinter]
root_package = fsm_llm
include_external_packages = True
# An import under `if TYPE_CHECKING:` costs nothing at run time.
exclude_type_checking_imports = True

[importlinter:contract:litellm-one-module]
name = litellm is imported by one module, fsm_llm.llm.providers.litellm
type = forbidden
source_modules =
    fsm_llm
forbidden_modules =
    litellm
ignore_imports =
    # permanent: the one LLM layer (step 73: the old `llm.py`, split into the `llm/` package,
    # keeps the one `import litellm` in `llm/providers/litellm.py`).
    fsm_llm.llm.providers.litellm -> litellm

[importlinter:contract:testing-is-never-imported]
name = no library module imports fsm_llm.testing
type = forbidden
source_modules =
    fsm_llm.*
forbidden_modules =
    fsm_llm.testing

[importlinter:contract:pytest-is-not-shipped]
name = no shipped module imports pytest
type = forbidden
source_modules =
    fsm_llm
forbidden_modules =
    pytest
    _pytest

[importlinter:contract:entry-modules-are-leaves]
name = nothing imports the entry modules fsm_llm.runner and fsm_llm.__main__
type = forbidden
source_modules =
    fsm_llm.*
forbidden_modules =
    fsm_llm.runner
    fsm_llm.__main__
ignore_imports =
    # permanent: `python -m fsm_llm` is the one entry that hands over to the
    # runner (a lazy import inside `main_cli`); no other module may.
    fsm_llm.__main__ -> fsm_llm.runner

[importlinter:contract:reasoning-is-imported-by-agents-only]
name = no module outside fsm_llm.reasoning and fsm_llm.agents imports fsm_llm.reasoning
type = forbidden
source_modules =
    fsm_llm.*
forbidden_modules =
    fsm_llm.reasoning
ignore_imports =
    # the package's own modules import each other
    fsm_llm.reasoning.** -> fsm_llm.reasoning.**
    # permanent (D-016 c): ReasoningReactAgent is the agents pattern built on the reasoning
    # engine, and no roadmap row retires the edge; it is reported to the user as a decision.
    fsm_llm.agents.reasoning_react -> fsm_llm.reasoning

# Step 67 (security split): the first layer package. `security` is a KERNEL module (D-014,
# D-016): it imports the standard library only, today and by contract, which is stricter
# than the kernel rule of step 95 (kernel modules import no layer package). The forbidden
# set is `fsm_llm.*` (every direct child), not the bare root: with the root as the
# forbidden module and a source inside it, import-linter reports nothing (measured at
# step 67: a planted `from fsm_llm.constants import ...` in `security/paths.py` was missed).
[importlinter:contract:security-is-a-leaf]
name = fsm_llm.security imports no other fsm_llm module (standard library only)
type = forbidden
source_modules =
    fsm_llm.security
forbidden_modules =
    fsm_llm.*
ignore_imports =
    # the package's own modules import each other
    fsm_llm.security.** -> fsm_llm.security.**

# Steps 69 and 70 (definitions split, then `codes`, `schema`, `state_kinds` and
# `transition_evaluator` placed): the layer package `core` (L0). It reads only the kernel
# (`constants`, `logging`, `security`); step 71 moved `expressions` into it as `core.expressions`,
# a package whose modules import each other and `core.definitions` and are read by
# `core.transition_evaluator`; step 75 added `core.verify` (the validator split into modules and
# `flow`, which read the kernel and `core` only, so this contract covers them with no new line (step 76 added `core.visualize`, the old `visualizer`; its one named debt, `core.visualize.cli -> cli_support`, was retired at step 83: `cli_support` is a kernel leaf now, D-033) and
# `fsm_llm.validator` left the lists of the `llm` and `context` contracts below: the module is
# gone and both layers may import `core`); it never reaches a higher layer or a subpackage
# (`FSMDefinition._check_synthesize_states` imports `core.transition_evaluator` lazily, a core
# edge). The list is every module that is not core and not kernel today; step 95 replaces it
# with the `layers` contract of D-016.
[importlinter:contract:core-imports-no-higher-layer]
name = fsm_llm.core imports no engine, llm, context, okf, skills, tools, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.core
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.memory
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows
ignore_imports =
    # the package's own modules import each other
    fsm_llm.core.** -> fsm_llm.core.**

# Step 72 (utilities split; `llm.py` and `context.py` became the packages `llm/` and `context/`):
# the layer package `llm` (L1) reads the kernel (`constants`, `logging`), `core` (the models in
# `core.definitions`, the number and bool coercions in `core.coerce`) and `fsm_llm.llm.ollama` (placed
# in `llm/` at step 73, so it is inside the package now), and nothing above it. `fsm_llm.utilities` is gone from the core contract
# above (the module no longer exists; its pieces are `llm.text`, `llm.json_extraction`,
# `context.filtering`, `core.coerce`, `core.loaders`). The list is every module that is neither
# `llm`, `core` or kernel today; step 95 replaces it with the `layers` contract of D-016.
[importlinter:contract:llm-imports-no-higher-layer]
name = fsm_llm.llm imports no engine, context, okf, skills, tools, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.llm
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows

# Step 74 (prompts split into `context/layout/`, `clear_keys_delta` moved down from `handlers`
# into `context/commit.py`): the layer package `context` (L3) reads the kernel (`constants`,
# `logging`), `core` and `llm` (the compactor's summary call) and nothing above it: it imports no
# engine module (`handlers` was the one edge, retired by the move), no peer layer (`okf`,
# `skills`) and no subpackage. Same module list as the `llm` contract above, which step 95
# replaces together with this one by the `layers` contract of D-016.
[importlinter:contract:context-imports-no-higher-layer]
name = fsm_llm.context imports no engine, okf, skills, tools, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.context
forbidden_modules =
    fsm_llm.agents
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows

# Step 77 (handlers split into the package `handlers/`, at the same dotted path because 13 examples
# import `fsm_llm.handlers.HandlerTiming`): `handlers` sits in the engine layer (D-016: `engine :
# handlers`, peers that import neither each other nor anything above them). Today it reads the
# kernel (`constants`, `logging`), `core` (the errors' base, `BuildError`, `checked_key_names`) and
# `context.commit` (`clear_keys_delta`). It imports no engine peer (`api`, `engine` and
# `engine` (with `engine.kinds`, the old `executors`) import it, never the reverse) and no subpackage; the list is those peers plus every
# module above the engine layer. Step 95 replaces it with the `layers` contract of D-016.
[importlinter:contract:handlers-import-no-engine-peer-or-higher-layer]
name = fsm_llm.handlers imports no engine peer or subpackage module
type = forbidden
source_modules =
    fsm_llm.handlers
forbidden_modules =
    fsm_llm.agents
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.monitor
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.workflows

# Step 78 (fsm.py split into the layer package `engine/fsm/`, the first module of the `engine`
# layer, L4 of D-016): `engine` reads the kernel (`constants`, `logging`, `security`), `core`, `llm`,
# `context` and `handlers`, plus the modules that moved into it (`api` is `engine/api/` since
# step 81; `classification`, `session` and `builders` are `engine/*.py` since step 82). It imports
# no subpackage, no okf or skills module and no entry module. The `core`, `llm`, `context` and
# `handlers` contracts above forbid `fsm_llm.engine`, so the lower layers never import it. Step 83
# moved `okf_bridge` into `engine/`: it is the engine's one module on `okf` (one ignore line below),
# and two contracts at the end of this file keep it isolated both ways. What waits for step 95: the
# `layers` contract replaces these lists.
[importlinter:contract:engine-imports-no-subpackage-or-okf-or-skills]
name = fsm_llm.engine imports no subpackage, okf, skills or entry module
type = forbidden
source_modules =
    fsm_llm.engine
forbidden_modules =
    fsm_llm.agents
    fsm_llm.eval
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.workflows
ignore_imports =
    # permanent (D-033): the bridge between memory, plain FSMs and OKF is the one engine module
    # that reads `okf` (the engine layer sits above it); every other engine module stays forbidden.
    fsm_llm.engine.okf_bridge -> fsm_llm.okf

# Step 79 (pipeline.py split into the layer package `engine/turn/`): the per-turn engine sits
# below the conversation manager (`engine/fsm`, which builds a `MessagePipeline`), the `API`
# that wraps the manager, the builders and the session store; it imports none of them, directly
# or through another module. Step 95 replaces this with the `layers` contract of D-016, where
# these become intra-engine edges.
[importlinter:contract:engine-turn-imports-no-manager-or-api]
name = fsm_llm.engine.turn imports no manager, API, builder or session module
type = forbidden
source_modules =
    fsm_llm.engine.turn
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.fsm
    fsm_llm.engine.session

# Step 80 (executors.py became the layer package `engine/kinds/`; the conversation Pass-1
# machinery moved out of `engine/turn/` into it): the kind executors sit BELOW the turn pipeline
# (the pipeline imports them, never the reverse) and below the manager, the API, the builders
# and the session store. They reach the pipeline only through the `_PipelineServices` protocol
# of `engine/kinds/services.py`. The contract does not see an import under `TYPE_CHECKING`
# (`exclude_type_checking_imports`); `test_executors.py` scans every module of the package for
# one. The `engine-turn` contract above does not forbid `engine.kinds` (the turn calls it).
# Step 95 replaces this with the `layers` contract of D-016, where it is an intra-engine edge.
[importlinter:contract:engine-kinds-imports-no-turn-or-manager-or-api]
name = fsm_llm.engine.kinds imports no turn, manager, API, builder or session module
type = forbidden
source_modules =
    fsm_llm.engine.kinds
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.fsm
    fsm_llm.engine.session
    fsm_llm.engine.turn

# Step 81 (api.py split into the layer package `engine/api/`): the API is the top of the engine
# layer. It sits ABOVE the manager (`engine/fsm`), the turn (`engine/turn`) and the kinds
# (`engine/kinds`), which it reaches through `FSMManager` and the per-API `executors` map, and
# below the builders (`engine/builders.py` builds an `API`). So the three lower engine packages import it
# nowhere (the turn and the kinds contracts above name it; this contract holds the manager), and it
# imports no builder. The `core`, `llm`, `context` and `handlers` contracts forbid `fsm_llm.engine`
# as a whole, so the lower layers never import it either. Step 95 replaces these with the `layers`
# contract of D-016, where they are intra-engine edges.
[importlinter:contract:engine-fsm-imports-no-api-or-builder]
name = fsm_llm.engine.fsm imports no API or builder module
type = forbidden
source_modules =
    fsm_llm.engine.fsm
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders

[importlinter:contract:engine-api-imports-no-builder]
name = fsm_llm.engine.api imports no builder module
type = forbidden
source_modules =
    fsm_llm.engine.api
forbidden_modules =
    fsm_llm.engine.builders

# Step 82 (classification.py, session.py and builders.py moved into `engine/` as single modules):
# the classifier and the session store are leaves of the engine layer. They read the kernel, `core`,
# `llm` and `context` only; the turn, the kinds, the manager and the API import them, never the
# reverse, and neither reaches the builders. (`engine/builders.py` sits on top: it builds an `API` and
# an `FSMManager`, held by the two contracts above.) Step 95 replaces this with the `layers`
# contract of D-016, where these are intra-engine edges.
[importlinter:contract:engine-classification-and-session-are-leaves]
name = fsm_llm.engine classification and session import no engine peer
type = forbidden
source_modules =
    fsm_llm.engine.classification
    fsm_llm.engine.session
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.fsm
    fsm_llm.engine.kinds
    fsm_llm.engine.turn

# Step 83 (okf.py became the layer package `okf/`, `okf_bridge.py` moved into `engine/`, the okf
# text helpers moved to the kernel module `text.py`; D-032, D-033). `okf` (L3) reads the kernel,
# `core` (`OKFError`) and `security`; it imports no engine, llm, context or handlers module, no
# peer layer (`skills`) and no subpackage. ONE named debt: the `export` subcommand of the CLI calls
# `bundle_from_memory_entries`, which lives in `engine/okf_bridge.py` (it needs `handlers`).
[importlinter:contract:okf-imports-no-engine-or-higher-layer]
name = fsm_llm.okf imports no engine, llm, context, skills, tools, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.okf
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.monitor
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows
ignore_imports =
    # retired by: step 95 (the `layers` contract decides: exempt the `*.cli` entry modules, or move
    # `bundle_from_memory_entries` down into `okf/`); the CLI is an entry point that composes layers.
    fsm_llm.okf.cli -> fsm_llm.engine.okf_bridge

# Step 83: `text` and `cli_support` are kernel leaves: they read the standard library, `constants`
# and (`cli_support` only) `env`, never a layer package, a subpackage or an entry module. This is
# why `cli_support` left the forbidden lists of the layer contracts above (D-033).
[importlinter:contract:kernel-leaves-import-no-layer]
name = fsm_llm.text and fsm_llm.cli_support import no layer package, subpackage or entry module
type = forbidden
source_modules =
    fsm_llm.text
    fsm_llm.cli_support
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.core
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows

# Step 83: the OKF bridge sits in the engine layer (it needs `handlers`) but is isolated from the
# rest of the engine in both directions: it imports no engine peer, and no engine peer imports it.
# The second contract is what keeps the engine off `okf` (the ignore line of the engine contract
# above hides the bridge's own `okf` edge, so a chain through the bridge would otherwise be missed).
[importlinter:contract:engine-okf-bridge-imports-no-engine-peer]
name = fsm_llm.engine.okf_bridge imports no engine peer
type = forbidden
source_modules =
    fsm_llm.engine.okf_bridge
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.classification
    fsm_llm.engine.fsm
    fsm_llm.engine.kinds
    fsm_llm.engine.session
    fsm_llm.engine.turn

[importlinter:contract:engine-imports-no-okf-bridge]
name = no engine peer imports fsm_llm.engine.okf_bridge
type = forbidden
source_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.classification
    fsm_llm.engine.fsm
    fsm_llm.engine.kinds
    fsm_llm.engine.session
    fsm_llm.engine.turn
forbidden_modules =
    fsm_llm.engine.okf_bridge

# Step 84 (agent_skills.py and agent_skills_cli.py became the layer package `skills/`, D-034).
# `skills` (L3) reads the kernel (`constants`, `frontmatter`, `security`, `text`, `cli_support`)
# and `core` (`SkillError`); it imports no okf module (a sibling in the Section 5.2 row; the text
# helpers it shares with okf are the kernel module `text`), no engine, llm, context or handlers
# module and no subpackage; the agents-side tools are `fsm_llm.agents.agent_skills`, which
# imports this package, never the reverse. No debt: the CLI needs nothing above the kernel.
[importlinter:contract:skills-imports-no-okf-engine-or-higher-layer]
name = fsm_llm.skills imports no okf, engine, llm, context, tools, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.skills
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows

# Step 85 (ToolRegistry, the tool models and their helpers moved down from `agents/` into the layer
# package `tools/`, D-035 and D-036). `tools` (L3, a sibling of `context`, `okf`, `skills` and the
# later `policy` in the Section 5.2 row) reads the kernel (`logging`), `core` (`AgentError`, the
# base of its two errors, which moved down into `core.definitions.errors` for this) and nothing
# else: no agents, engine, llm, handlers or peer layer, no subpackage, no entry module. ONE named
# debt: `redact_secret_entries` (the registry logs through it) calls
# `context.filtering.redact_context`, a `context` module; step 95 decides between moving the filter
# down to `core` and a sibling exemption. The rest of the layer contracts above forbid
# `fsm_llm.tools` for the layers below and beside it (`core`, `llm`, `context`, `okf`, `skills`,
# the kernel leaves): the engine, the handlers and the subpackages may import it.
[importlinter:contract:tools-imports-no-agents-engine-or-peer-layer]
name = fsm_llm.tools imports no agents, engine, llm, handlers, okf, skills, context, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.tools
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.workflows
ignore_imports =
    # retired by: step 95 (the `layers` contract decides: move `redact_context` and its module
    # down to `core`, or exempt the `tools` to `context` edge); one import, in `arguments.py`.
    fsm_llm.tools.arguments -> fsm_llm.context.filtering

# Step 86 (the approval types and the HITL manager moved from `agents/` into the layer package
# `policy/`, D-037). `policy` sits above `tools` (it wraps a tool call and uses the tool models, the
# per-call timeout and the redaction helper): it reads the kernel (`constants`, `logging`), `core`
# (`AgentError`, the base of `ApprovalDeniedError`) and `fsm_llm.tools`, and nothing else: no agents
# (the driver-only approval grant stays in `agents.base`), engine, llm, handlers or peer layer, no
# subpackage, no entry module. `policy -> tools` is a deviation from the roadmap Section 5.2 row
# (`context | retrieval | okf | skills | tools | policy`, independent siblings): step 95 amends the
# `layers` contract so `policy` sits above `tools`; until then `tools` and the layers below it forbid
# `fsm_llm.policy` (the lists above). `context` is forbidden too, which is why the one named debt of
# the `tools` contract (`tools.arguments -> context.filtering`, reached through `tools`) is repeated.
[importlinter:contract:policy-imports-no-agents-engine-or-peer-layer]
name = fsm_llm.policy imports no agents, engine, llm, handlers, okf, skills, context or subpackage module
type = forbidden
source_modules =
    fsm_llm.policy
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.workflows
ignore_imports =
    # retired by: step 95 (the `tools` contract's debt, reached through `fsm_llm.tools`; the
    # `layers` contract decides how `redact_context` is reached); not an import of `policy`.
    fsm_llm.tools.arguments -> fsm_llm.context.filtering

# Step 87 (agents/base.py became the package agents/base/, D-039). `BaseAgent` is the base of every
# pattern, so the package imports no pattern module (a pattern imports it; the reverse would be a
# cycle), no meta-builder module and no transport (`mcp`, `remote`): it reads its sibling support
# modules (`constants`, `definitions`, `exceptions`, `handlers`, `summarization`, `tools`) and the
# layers below `agents`.
[importlinter:contract:agents-base-imports-no-pattern]
