# Import contracts for the `fsm_llm` package, run by `make lint-imports`
# (`lint-imports`, from import-linter; the engine is grimp) and, as one pytest test, by
# tests/test_fsm_llm_regression/test_import_contract.py (so pytest gates it).
#
# Plan d454fd62, step 95: the layered Section 5.2 contract of the 2026 roadmap (D-016, amended
# by D-042), written for the real tree. The file holds, in this order:
#   1. `layers-section-5-2`: a layer package imports only the layers below it. It replaces the
#      per-package "imports no higher layer" lists of steps 69 to 86 (`llm`, `context`,
#      `handlers`, `okf`, `skills`, `tools`, `policy` and the layer part of `engine`).
#   2. `kernel-imports-no-layer`: the kernel modules import no layer package.
#   3. What the layers contract cannot say: the L3 layers read no `llm`, `policy` is independent
#      of the other L3 layers, `core` reads no `memory`, `engine` reads no `okf` or `skills`
#      outside the one bridge module.
#   4. litellm, testing, pytest, the entry modules, `reasoning` and `security`.
#   5. The order of the modules INSIDE one layer package (`engine`, `agents`, `workflows`,
#      `monitor`): the roadmap's contract orders packages, not the modules in them.
# A contract is never weakened to pass: a debt is an `ignore_imports` line that names the row
# retiring it (`# retired by: <row>`) or the written reason it stays (`# permanent: <reason>`);
# the test pins the whole set of debts, so adding one is a visible diff. import-linter fails on
# an ignore that matches no import, so a stale entry is caught.
#
# No `forbidden` contract here uses `allow_indirect_imports`: a chain through another module
# counts, so a re-export cannot launder an import.
#
# Source `fsm_llm.*` (every direct child, so a new module is covered with no edit) or an explicit
# module list is used where the forbidden module is itself inside `fsm_llm`: with the bare root
# as source import-linter treats the forbidden module as part of the source and reports nothing
# (measured at step 61: a planted import was missed). The root `fsm_llm/__init__.py` is not a
# child: `TestPackageInitImportsNoSubpackage` in tests/test_packaging.py covers it.
#
# A new layer package: add it to the `layers` contract (an absent package stays optional there,
# in parentheses) and to the forbidden list of the kernel contract; the test cross-checks both
# against the directories of `src/fsm_llm/`.

[importlinter]
root_package = fsm_llm
include_external_packages = True
# An import under `if TYPE_CHECKING:` costs nothing at run time.
exclude_type_checking_imports = True

# 1. The layered contract. Top to bottom, as the roadmap's Section 5.2 table with the measured
# deviations of D-014, D-016 and D-042; `|` joins independent siblings (no import either way), a
# row may import every row below it, never one above. A name in parentheses is a package of the
# roadmap that does not exist yet (`serve`, `oo`, `retrieval`): optional,
# so it takes its place the day it is created (`runtime` did, plan 21e6f00d).
#   serve | monitor | eval                      L7  consumers
#   agents | synthesis | workflows | reasoning  L6  patterns and runtimes
#   simulation | oo                             L5  (`oo` absent)
#   engine                                      L4  API, manager, turn, kinds, builders, session
#   handlers                                    L4  below the engine: the engine imports it, never the reverse
#                                                   (D-016 wrote `engine : handlers`; this is stricter and holds)
#   policy                                      L3  above `tools` (D-037, D-042): it gates a tool call
#   context | retrieval | okf | skills | tools L3  independent siblings
#   runtime                                     L2  the event log: imports core, llm and the kernel only
#   llm                                         L1
#   core                                        L0
# Not in the contract: the kernel (`constants`, `logging`, `security`, `text`, `env`, `frontmatter`,
# `memory`, `cli_support`: held by the kernel contract), the entry modules (`runner`, `__main__`) and
# `testing` (held by the entry and testing contracts).
# Debts, each measured by the first run of this contract on the real tree (progress.md "Step 95"):
# three named, each with its retiring row or its permanent reason (D-016 a, b, c). Six more edges
# the first run listed were fixed by moving a symbol down instead (D-042).
[importlinter:contract:layers-section-5-2]
name = Section 5.2 layers: a layer package imports only the layers below it
type = layers
containers =
    fsm_llm
layers =
    (serve) | monitor | eval
    agents | synthesis | workflows | reasoning
    simulation | (oo)
    engine
    handlers
    policy
    context | (retrieval) | okf | skills | tools
    runtime
    llm
    core
ignore_imports =
    # permanent (D-016 c): `ReasoningReactAgent` is the agents pattern built on the reasoning
    # engine, and no roadmap row retires the edge; it is reported to the user as a decision.
    fsm_llm.agents.reasoning_react -> fsm_llm.reasoning

# 2. The kernel (D-014, D-016): modules every layer may read, so they read no layer package, no
# subpackage, no `testing` and no entry module. A kernel module imports only the standard library
# and other kernel modules. `security` is stricter still (`security-is-a-leaf` below: standard
# library only). `text` and `cli_support` were the first two held this way (step 83, D-033); the
# contract that named them is replaced by this one.
[importlinter:contract:kernel-imports-no-layer]
name = kernel modules import no layer package, subpackage, testing or entry module
type = forbidden
source_modules =
    fsm_llm.aio
    fsm_llm.cli_support
    fsm_llm.constants
    fsm_llm.env
    fsm_llm.frontmatter
    fsm_llm.logging
    fsm_llm.memory
    fsm_llm.security
    fsm_llm.text
forbidden_modules =
    fsm_llm.__main__
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.core
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.runtime
    fsm_llm.simulation
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows

# 3. What the layers contract cannot say. The L3 layers sit above `llm` in the table, so they MAY
# import it by that contract; only `context` needs it (the compactor's summary call). `okf`,
# `skills`, `tools` and `policy` read the kernel and `core` and nothing else (steps 83 to 86).
[importlinter:contract:l3-layers-import-no-llm]
name = fsm_llm.okf, skills, tools and policy import no llm module
type = forbidden
source_modules =
    fsm_llm.okf
    fsm_llm.skills
    fsm_llm.tools
    fsm_llm.policy
forbidden_modules =
    fsm_llm.llm

# `policy` sits above `tools` (it wraps a tool call; D-037), which the layers contract expresses by
# giving it a row of its own above the L3 row. That row would let it import `context`, `okf` and
# `skills` too; it reads none of them (measured at step 86) and stays independent of them.
[importlinter:contract:policy-imports-no-sibling-layer]
name = fsm_llm.policy imports no context, okf or skills module
type = forbidden
source_modules =
    fsm_llm.policy
forbidden_modules =
    fsm_llm.context
    fsm_llm.okf
    fsm_llm.skills

[importlinter:contract:litellm-one-module]
name = litellm is imported by one module, fsm_llm.llm.providers.litellm
type = forbidden
source_modules =
    fsm_llm
forbidden_modules =
    litellm
ignore_imports =
    # permanent: the one LLM layer (step 73: the old `llm.py`, split into the `llm/` package,
    # keeps the one `import litellm` in `llm/providers/litellm.py`).
    fsm_llm.llm.providers.litellm -> litellm

[importlinter:contract:testing-is-never-imported]
name = no library module imports fsm_llm.testing
type = forbidden
source_modules =
    fsm_llm.*
forbidden_modules =
    fsm_llm.testing

# `simulation` (L5) is the generic simulator the consumers share: it reads no consumer. The layers
# contract already keeps it off `eval`, `synthesis`, `agents`, `workflows`, `reasoning` and
# `monitor` (they sit above it); this one names them with `testing` and the entry modules, so a
# move of the row cannot lift the rule (plan c720601d, step 2).
[importlinter:contract:simulation-imports-no-consumer]
name = fsm_llm.simulation imports no eval, synthesis, agents, workflows, reasoning, monitor, testing or entry module
type = forbidden
source_modules =
    fsm_llm.simulation
forbidden_modules =
    fsm_llm.__main__
    fsm_llm.agents
    fsm_llm.eval
    fsm_llm.monitor
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.workflows

[importlinter:contract:pytest-is-not-shipped]
name = no shipped module imports pytest
type = forbidden
source_modules =
    fsm_llm
forbidden_modules =
    pytest
    _pytest

[importlinter:contract:entry-modules-are-leaves]
name = nothing imports the entry modules fsm_llm.runner and fsm_llm.__main__
type = forbidden
source_modules =
    fsm_llm.*
forbidden_modules =
    fsm_llm.runner
    fsm_llm.__main__
ignore_imports =
    # permanent: `python -m fsm_llm` is the one entry that hands over to the
    # runner (a lazy import inside `main_cli`); no other module may.
    fsm_llm.__main__ -> fsm_llm.runner

# Stricter than the layers contract, which lets `monitor`, `eval` and `serve` import `reasoning`
# (they sit above it): only `agents.reasoning_react` does, the one permanent debt of D-016 c (the
# same edge is an ignore line of the layers contract, with the same tag).
[importlinter:contract:reasoning-is-imported-by-agents-only]
name = no module outside fsm_llm.reasoning and fsm_llm.agents imports fsm_llm.reasoning
type = forbidden
source_modules =
    fsm_llm.*
forbidden_modules =
    fsm_llm.reasoning
ignore_imports =
    # permanent: the package's own modules import each other
    fsm_llm.reasoning.** -> fsm_llm.reasoning.**
    # permanent (D-016 c): ReasoningReactAgent is the agents pattern built on the reasoning
    # engine, and no roadmap row retires the edge; it is reported to the user as a decision.
    fsm_llm.agents.reasoning_react -> fsm_llm.reasoning

# Step 67 (security split): the first layer package. `security` is a KERNEL module (D-014,
# D-016): it imports the standard library only, today and by contract, which is stricter
# than the kernel contract above (kernel modules import no layer package). The forbidden
# set is `fsm_llm.*` (every direct child), not the bare root: with the root as the
# forbidden module and a source inside it, import-linter reports nothing (measured at
# step 67: a planted `from fsm_llm.constants import ...` in `security/paths.py` was missed).
[importlinter:contract:security-is-a-leaf]
name = fsm_llm.security imports no other fsm_llm module (standard library only)
type = forbidden
source_modules =
    fsm_llm.security
forbidden_modules =
    fsm_llm.*
ignore_imports =
    # permanent: the package's own modules import each other
    fsm_llm.security.** -> fsm_llm.security.**

# Steps 69 and 70 (definitions split, then `codes`, `schema`, `state_kinds` and
# `transition_evaluator` placed): the layer package `core` (L0). It reads only the kernel
# (`constants`, `logging`, `security`); step 71 moved `expressions` into it as `core.expressions`,
# a package whose modules import each other and `core.definitions` and are read by
# `core.transition_evaluator`; step 75 added `core.verify` (the validator split into modules and
# `flow`, which read the kernel and `core` only, so this contract covers them with no new line (step 76 added `core.visualize`, the old `visualizer`; its one named debt, `core.visualize.cli -> cli_support`, was retired at step 83: `cli_support` is a kernel leaf now, D-033) and
# `fsm_llm.validator` left the lists of the `llm` and `context` contracts below: the module is
# gone and both layers may import `core`); it never reaches a higher layer or a subpackage
# (`FSMDefinition._check_synthesize_states` imports `core.transition_evaluator` lazily, a core
# edge). Step 95: the `layers` contract (core is its bottom row) now forbids every layer package;
# this list stays whole for what that contract cannot see, `fsm_llm.memory` (a kernel module the
# core does not read) and the entry and testing modules.
[importlinter:contract:core-imports-no-higher-layer]
name = fsm_llm.core imports no engine, llm, context, okf, skills, tools, policy or subpackage module
type = forbidden
source_modules =
    fsm_llm.core
forbidden_modules =
    fsm_llm.agents
    fsm_llm.context
    fsm_llm.engine
    fsm_llm.eval
    fsm_llm.handlers
    fsm_llm.llm
    fsm_llm.memory
    fsm_llm.monitor
    fsm_llm.okf
    fsm_llm.policy
    fsm_llm.reasoning
    fsm_llm.runner
    fsm_llm.simulation
    fsm_llm.skills
    fsm_llm.synthesis
    fsm_llm.testing
    fsm_llm.tools
    fsm_llm.workflows
ignore_imports =
    # permanent: the package's own modules import each other
    fsm_llm.core.** -> fsm_llm.core.**

# Step 78 (fsm.py split into the layer package `engine/fsm/`, the first module of the `engine`
# layer, L4 of D-016): `engine` reads the kernel (`constants`, `logging`, `security`), `core`, `llm`,
# `context`, `handlers` and `policy`, plus the modules that moved into it (`api` is `engine/api/`
# since step 81; `classification`, `session` and `builders` are `engine/*.py` since step 82). Step 95:
# the layers contract keeps the engine off every subpackage and the entry modules; this contract
# keeps it off `okf` and `skills`, which the layers contract would allow (they sit below the
# engine). Step 83 moved `okf_bridge` into `engine/`: it is the engine's one module on `okf` (two
# ignore lines below: the package and `okf.memory_export`, from which it re-exports
# `bundle_from_memory_entries`), and two contracts further down keep it isolated both ways.
[importlinter:contract:engine-imports-no-okf-or-skills]
name = fsm_llm.engine imports no okf or skills module
type = forbidden
source_modules =
    fsm_llm.engine
forbidden_modules =
    fsm_llm.okf
    fsm_llm.skills
ignore_imports =
    # permanent (D-033): the bridge between memory, plain FSMs and OKF is the one engine module
    # that reads `okf` (the engine layer sits above it); every other engine module stays forbidden.
    fsm_llm.engine.okf_bridge -> fsm_llm.okf
    # permanent (D-033, D-042): the same bridge re-exports `bundle_from_memory_entries`, defined in
    # `okf/memory_export.py` since step 95.
    fsm_llm.engine.okf_bridge -> fsm_llm.okf.memory_export

# Step 79 (pipeline.py split into the layer package `engine/turn/`): the per-turn engine sits
# below the conversation manager (`engine/fsm`, which builds a `MessagePipeline`), the `API`
# that wraps the manager, the builders and the session store; it imports none of them, directly
# or through another module. The layers contract orders the packages, not the modules inside
# `engine`, so this contract stays (the internal order of the engine).
[importlinter:contract:engine-turn-imports-no-manager-or-api]
name = fsm_llm.engine.turn imports no manager, API, builder or session module
type = forbidden
source_modules =
    fsm_llm.engine.turn
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.fsm
    fsm_llm.engine.session

# Step 80 (executors.py became the layer package `engine/kinds/`; the conversation Pass-1
# machinery moved out of `engine/turn/` into it): the kind executors sit BELOW the turn pipeline
# (the pipeline imports them, never the reverse) and below the manager, the API, the builders
# and the session store. They reach the pipeline only through the `_PipelineServices` protocol
# of `engine/kinds/services.py`. The contract does not see an import under `TYPE_CHECKING`
# (`exclude_type_checking_imports`); `test_executors.py` scans every module of the package for
# one. The `engine-turn` contract above does not forbid `engine.kinds` (the turn calls it).
# Kept at step 95: the layers contract does not order the modules inside `engine`.
[importlinter:contract:engine-kinds-imports-no-turn-or-manager-or-api]
name = fsm_llm.engine.kinds imports no turn, manager, API, builder or session module
type = forbidden
source_modules =
    fsm_llm.engine.kinds
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.fsm
    fsm_llm.engine.session
    fsm_llm.engine.turn

# Step 81 (api.py split into the layer package `engine/api/`): the API is the top of the engine
# layer. It sits ABOVE the manager (`engine/fsm`), the turn (`engine/turn`) and the kinds
# (`engine/kinds`), which it reaches through `FSMManager` and the per-API `executors` map, and
# below the builders (`engine/builders.py` builds an `API`). So the three lower engine packages import it
# nowhere (the turn and the kinds contracts above name it; this contract holds the manager), and it
# imports no builder. The `core`, `llm`, `context` and `handlers` contracts forbid `fsm_llm.engine`
# as a whole, so the lower layers never import it either (the layers contract now says so for the
# whole engine). Kept at step 95: it does not order the modules inside `engine`.
[importlinter:contract:engine-fsm-imports-no-api-or-builder]
name = fsm_llm.engine.fsm imports no API or builder module
type = forbidden
source_modules =
    fsm_llm.engine.fsm
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders

[importlinter:contract:engine-api-imports-no-builder]
name = fsm_llm.engine.api imports no builder module
type = forbidden
source_modules =
    fsm_llm.engine.api
forbidden_modules =
    fsm_llm.engine.builders

# Step 82 (classification.py, session.py and builders.py moved into `engine/` as single modules):
# the classifier and the session store are leaves of the engine layer. They read the kernel, `core`,
# `llm` and `context` only; the turn, the kinds, the manager and the API import them, never the
# reverse, and neither reaches the builders. (`engine/builders.py` sits on top: it builds an `API` and
# an `FSMManager`, held by the two contracts above.) Kept at step 95: the layers contract does not
# order the modules inside `engine`.
[importlinter:contract:engine-classification-and-session-are-leaves]
name = fsm_llm.engine classification and session import no engine peer
type = forbidden
source_modules =
    fsm_llm.engine.classification
    fsm_llm.engine.intent_router
    fsm_llm.engine.session
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.fsm
    fsm_llm.engine.kinds
    fsm_llm.engine.turn

# Step 83: the OKF bridge sits in the engine layer (it needs `handlers`) but is isolated from the
# rest of the engine in both directions: it imports no engine peer, and no engine peer imports it.
# The second contract is what keeps the engine off `okf` (the ignore lines of the engine contract
# above hide the bridge's own `okf` edges, so a chain through the bridge would otherwise be missed).
[importlinter:contract:engine-okf-bridge-imports-no-engine-peer]
name = fsm_llm.engine.okf_bridge imports no engine peer
type = forbidden
source_modules =
    fsm_llm.engine.okf_bridge
forbidden_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.classification
    fsm_llm.engine.fsm
    fsm_llm.engine.intent_router
    fsm_llm.engine.kinds
    fsm_llm.engine.session
    fsm_llm.engine.turn

[importlinter:contract:engine-imports-no-okf-bridge]
name = no engine peer imports fsm_llm.engine.okf_bridge
type = forbidden
source_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.classification
    fsm_llm.engine.fsm
    fsm_llm.engine.intent_router
    fsm_llm.engine.kinds
    fsm_llm.engine.session
    fsm_llm.engine.turn
forbidden_modules =
    fsm_llm.engine.okf_bridge

# Plan ace7a8c8 step 22 (D-059): `engine/context.py` (the run context) and `engine/executables/`
# (the executable protocol, the FSM-body adapter, the registry) sit ABOVE the API. The engine
# packages below them import neither, so `import fsm_llm` can never load them through the engine
# and a turn never depends on a registry. They import no subpackage: the layers contract already
# keeps the engine off every L6 package, so a built-in reaches the registry through the
# `executable_sources` namespace. No `ignore_imports`.
[importlinter:contract:engine-below-executables-imports-no-executables-or-context]
name = engine peers import no executables or run context
type = forbidden
source_modules =
    fsm_llm.engine.api
    fsm_llm.engine.builders
    fsm_llm.engine.classification
    fsm_llm.engine.events
    fsm_llm.engine.fsm
    fsm_llm.engine.intent_router
    fsm_llm.engine.kinds
    fsm_llm.engine.okf_bridge
    fsm_llm.engine.session
    fsm_llm.engine.turn
forbidden_modules =
    fsm_llm.engine.executables
    fsm_llm.engine.context

# Step 87 (agents/base.py became the package agents/base/, D-039). `BaseAgent` is the base of every
# pattern, so the package imports no pattern module (a pattern imports it; the reverse would be a
# cycle), no meta-builder module and no transport (`mcp`, `remote`): it reads its sibling support
# modules (`constants`, `definitions`, `exceptions`, `handlers`, `summarization`, `tools`) and the
# layers below `agents`.
[importlinter:contract:agents-base-imports-no-pattern]
name = fsm_llm.agents.base imports no agent pattern, meta-builder or transport module
type = forbidden
source_modules =
    fsm_llm.agents.base
forbidden_modules =
    fsm_llm.agents.adapt
    fsm_llm.agents.agent_graph
    fsm_llm.agents.agent_skills
    fsm_llm.agents.auto_memory
    fsm_llm.agents.builders
    fsm_llm.agents.composition
    fsm_llm.agents.debate
    fsm_llm.agents.evaluator_optimizer
    fsm_llm.agents.maker_checker
    fsm_llm.agents.mcp
    fsm_llm.agents.meta_builder
    fsm_llm.agents.meta_builders
    fsm_llm.agents.meta_cli
    fsm_llm.agents.meta_output
    fsm_llm.agents.meta_prompts
    fsm_llm.agents.meta_tools
    fsm_llm.agents.native_fc
    fsm_llm.agents.okf
    fsm_llm.agents.orchestrator
    fsm_llm.agents.parallel_react
    fsm_llm.agents.plan_execute
    fsm_llm.agents.prompt_chain
    fsm_llm.agents.python_tools
    fsm_llm.agents.react
    fsm_llm.agents.reasoning_react
    fsm_llm.agents.reflexion
    fsm_llm.agents.remote
    fsm_llm.agents.rewoo
    fsm_llm.agents.self_consistency
    fsm_llm.agents.semantic_memory
    fsm_llm.agents.semantic_tools
    fsm_llm.agents.swarm
    fsm_llm.agents.tool_registries
    fsm_llm.agents.verified_react

[importlinter:contract:agents-base-mixins-do-not-import-the-shell]
name = the mixins, helpers and surface of fsm_llm.agents.base do not import its shell (agent.py)
type = forbidden
source_modules =
    fsm_llm.agents.base.helpers
    fsm_llm.agents.base.hitl_gate
    fsm_llm.agents.base.outcome
    fsm_llm.agents.base.registration
    fsm_llm.agents.base.runs
    fsm_llm.agents.base.surface
forbidden_modules =
    fsm_llm.agents.base.agent

# Step 88 (agents/handlers.py became the package agents/handlers/, D-040). The handlers are what the
# patterns and `BaseAgent` register, so the package imports no pattern module, no meta-builder module,
# no transport and not `agents.base` (all of them import it; the reverse would be a cycle): it reads its
# sibling support modules (`constants`, `definitions`, `exceptions`, `tools`) and the layers below `agents`.
[importlinter:contract:agents-handlers-imports-no-pattern]
name = fsm_llm.agents.handlers imports no agent pattern, meta-builder, transport or base module
type = forbidden
source_modules =
    fsm_llm.agents.handlers
forbidden_modules =
    fsm_llm.agents.adapt
    fsm_llm.agents.agent_graph
    fsm_llm.agents.agent_skills
    fsm_llm.agents.auto_memory
    fsm_llm.agents.builders
    fsm_llm.agents.composition
    fsm_llm.agents.debate
