{
  "schema": "fsm-llm/executable",
  "kind": "pattern",
  "id": "verified_react",
  "name": "verified_react",
  "description": "ReAct agent whose answer is verified (retry with feedback) and that reflects every N steps",
  "lifecycle": "builtin",
  "requires": {
    "handlers": [
      "agents.verify_retry",
      "agents.periodic_reflection"
    ]
  },
  "body": {
    "extends": "react",
    "options_schema": {
      "type": "object",
      "properties": {
        "max_verify_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Extra attempts after the first when the verifier rejects the answer"
        }
      }
    },
    "options": {
      "max_verify_retries": 1
    },
    "run": {
      "hooks": [
        {
          "hook": "agents.verify_retry",
          "at": "after_run"
        },
        {
          "hook": "agents.periodic_reflection",
          "at": "on_iteration"
        }
      ]
    }
  }
}
