{
  "schema": "fsm-llm/executable",
  "kind": "pattern",
  "id": "maker_checker",
  "name": "maker_checker",
  "description": "Maker-Checker agent: a maker drafts, a checker judges, the maker revises until the checker passes or the revision cap is reached",
  "contract": {
    "inputs": [
      "task"
    ],
    "outputs": []
  },
  "requires": {
    "tools": "none",
    "handlers": [
      "agents.revision_count",
      "agents.maker_checker_checker",
      "agents.revise_entry",
      "agents.revise_exit",
      "agents.iteration_limiter",
      "agents.force_pass"
    ],
    "callables": [
      "maker_instructions",
      "checker_instructions"
    ]
  },
  "capabilities": [],
  "lifecycle": "builtin",
  "variables": [
    "make_instructions",
    "revise_instructions",
    "feedback_instructions",
    "score_instructions",
    "verdict_instructions"
  ],
  "body": {
    "fsm": {
      "name": "maker_checker_agent",
      "description": "Maker-Checker agent",
      "initial_state": "make",
      "persona": "You are an AI agent that produces high-quality outputs through a maker-checker process. You alternate between creating content and critically evaluating it to ensure the highest quality.",
      "states": {
        "make": {
          "id": "make",
          "description": "Maker generates a draft output",
          "purpose": "Produce a high-quality draft following the maker instructions",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "draft_output",
              "field_type": "any",
              "extraction_instructions": "Extract the 'draft_output' field (any) from the task and the 'task', 'observations' values in the 'Already extracted:' context. {{make_instructions}}",
              "context_keys": [
                "task",
                "observations"
              ],
              "required": true
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "check",
              "description": "Draft complete, proceed to checker review",
              "priority": 100
            }
          ]
        },
        "check": {
          "id": "check",
          "description": "Checker evaluates the draft",
          "purpose": "Critically evaluate the draft against quality criteria",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "checker_feedback",
              "field_type": "str",
              "extraction_instructions": "Extract the 'checker_feedback' field (str) from the task and the 'task', 'observations', 'draft_output', 'previous_draft' values in the 'Already extracted:' context. {{feedback_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "draft_output",
                "previous_draft"
              ],
              "required": true
            },
            {
              "field_name": "quality_score",
              "field_type": "float",
              "extraction_instructions": "Extract the 'quality_score' field (float) from the task and the 'task', 'observations', 'draft_output', 'previous_draft' values in the 'Already extracted:' context. {{score_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "draft_output",
                "previous_draft"
              ],
              "required": true
            },
            {
              "field_name": "checker_passed",
              "field_type": "bool",
              "extraction_instructions": "Extract the 'checker_passed' field (bool) from the task and the 'task', 'observations', 'draft_output', 'previous_draft' values in the 'Already extracted:' context. {{verdict_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "draft_output",
                "previous_draft"
              ],
              "required": false
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "output",
              "description": "Draft passed review, produce final output",
              "priority": 10,
              "conditions": [
                {
                  "description": "Checker approved, or the budget is spent",
                  "logic": {
                    "or": [
                      {
                        "==": [
                          {
                            "var": "checker_passed"
                          },
                          true
                        ]
                      },
                      {
                        "==": [
                          {
                            "var": "max_iterations_reached"
                          },
                          true
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "target_state": "revise",
              "description": "Draft needs revision based on feedback",
              "priority": 300,
              "conditions": [
                {
                  "description": "Checker found issues with the draft",
                  "logic": {
                    "==": [
                      {
                        "var": "checker_passed"
                      },
                      false
                    ]
                  }
                }
              ]
            },
            {
              "target_state": "revise",
              "description": "Fallback: revise if checker result unclear",
              "priority": 900,
              "conditions": []
            }
          ]
        },
        "revise": {
          "id": "revise",
          "description": "Maker revises the draft based on checker feedback",
          "purpose": "Address all checker feedback and produce an improved draft",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "draft_output",
              "field_type": "any",
              "extraction_instructions": "Extract the 'draft_output' field (any) from the task and the 'task', 'observations', 'previous_draft', 'checker_feedback' values in the 'Already extracted:' context. {{revise_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "previous_draft",
                "checker_feedback"
              ],
              "required": true
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "check",
              "description": "Revised draft ready for re-evaluation",
              "priority": 100
            }
          ]
        },
        "output": {
          "id": "output",
          "description": "Present the final reviewed output",
          "purpose": "Extract and present the final answer",
          "response_instructions": "Present the final, reviewed output as your answer.",
          "transitions": []
        }
      },
      "handler_only_keys": [
        "max_iterations_reached",
        "forced_stop_reason",
        "iteration_count",
        "observation_count",
        "refused_actions"
      ]
    },
    "handlers": [
      {
        "handler": "agents.revision_count",
        "on": "entry",
        "states": [
          "check"
        ]
      },
      {
        "handler": "agents.maker_checker_checker",
        "on": "context_update",
        "states": [
          "check"
        ]
      },
      {
        "handler": "agents.revise_entry",
        "on": "entry",
        "states": [
          "revise"
        ]
      },
      {
        "handler": "agents.revise_exit",
        "on": "exit",
        "states": [
          "revise"
        ]
      },
      {
        "handler": "agents.iteration_limiter",
        "on": "state",
        "keys": [
          "max_iterations_reached"
        ],
        "params": {
          "early": false
        }
      },
      {
        "handler": "agents.force_pass",
        "on": "state",
        "states": [
          "check"
        ]
      }
    ],
    "options_schema": {
      "type": "object",
      "properties": {
        "cap": {
          "type": "boolean",
          "description": "Select the revision-cap variant (the check edge also fires at max_revisions)"
        },
        "max_revisions": {
          "type": "integer",
          "minimum": 0,
          "description": "Revision cap: the check edge fires at it (cap variant) and the force-pass handler reads it"
        },
        "quality_threshold": {
          "type": "number",
          "description": "Quality score from which a check passes without the verdict"
        }
      }
    },
    "options": {
      "cap": false,
      "max_revisions": 3,
      "quality_threshold": 0.7
    },
    "variants": {
      "cap": [
        {
          "op": "add",
          "path": "/states/check/transitions/0/conditions/0/logic/or/-",
          "value": {
            ">=": [
              {
                "var": "revision_count"
              },
              {
                "$hole": "max_revisions"
              }
            ]
          }
        }
      ]
    },
    "run": {
      "agent_type": "maker_checker",
      "answer_keys": [
        "draft_output"
      ],
      "judged": true,
      "context_seed": {
        "revision_count": 0
      }
    }
  }
}
