{
  "schema": "fsm-llm/executable",
  "kind": "pattern",
  "id": "auto_memory",
  "name": "auto_memory",
  "description": "ReAct agent with automatic memory recall before the run and persistence after it",
  "lifecycle": "builtin",
  "requires": {
    "handlers": [
      "agents.memory_recall",
      "agents.memory_remember"
    ]
  },
  "body": {
    "extends": "react",
    "options_schema": {
      "type": "object",
      "properties": {
        "recall_k": {
          "type": "integer",
          "minimum": 0,
          "description": "Memories injected before each run"
        },
        "recall_min_score": {
          "type": "number",
          "minimum": 0,
          "description": "Recalled memories scoring below this are dropped"
        },
        "auto_remember": {
          "type": "boolean",
          "description": "Persist the interaction after each run"
        },
        "remember_only_on_success": {
          "type": "boolean",
          "description": "Persist only runs that reached their goal"
        }
      }
    },
    "options": {
      "recall_k": 3,
      "recall_min_score": 0.25,
      "auto_remember": true,
      "remember_only_on_success": false
    },
    "run": {
      "hooks": [
        {
          "hook": "agents.memory_recall",
          "at": "before_run"
        },
        {
          "hook": "agents.memory_remember",
          "at": "after_run"
        }
      ]
    }
  }
}
