{
  "schema": "fsm-llm/executable",
  "kind": "pattern",
  "id": "debate",
  "name": "debate",
  "description": "Debate agent: a proposer, a critic and a judge argue in rounds until the judge reaches consensus or the round cap is reached",
  "contract": {
    "inputs": [
      "task"
    ],
    "outputs": []
  },
  "requires": {
    "tools": "none",
    "handlers": [
      "agents.debate_judge",
      "agents.debate_consensus_reset",
      "agents.debate_limiter"
    ],
    "callables": []
  },
  "capabilities": [],
  "lifecycle": "builtin",
  "variables": [
    "debate_persona",
    "proposition_instructions",
    "critique_instructions",
    "counter_instructions",
    "verdict_instructions",
    "consensus_instructions"
  ],
  "body": {
    "fsm": {
      "name": "debate_agent",
      "description": "Debate agent",
      "initial_state": "propose",
      "persona": "{{debate_persona}}",
      "states": {
        "propose": {
          "id": "propose",
          "description": "Generate or refine a proposition for the task",
          "purpose": "Present a well-reasoned argument or answer",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "proposition",
              "field_type": "str",
              "extraction_instructions": "Extract the 'proposition' field (str) from the task and the 'task', 'observations', 'debate_rounds' values in the 'Already extracted:' context. {{proposition_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "debate_rounds"
              ],
              "required": true
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "critique",
              "description": "Proposition ready for critique",
              "priority": 100
            }
          ]
        },
        "critique": {
          "id": "critique",
          "description": "Critically analyze the current proposition",
          "purpose": "Identify weaknesses, gaps, and counterpoints",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "critique",
              "field_type": "str",
              "extraction_instructions": "Extract the 'critique' field (str) from the task and the 'task', 'observations', 'proposition' values in the 'Already extracted:' context. {{critique_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "proposition"
              ],
              "required": true
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "counter",
              "description": "Critique complete, allow counter-argument",
              "priority": 100
            }
          ]
        },
        "counter": {
          "id": "counter",
          "description": "Address the critique with counter-arguments",
          "purpose": "Strengthen the proposition by addressing criticisms",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "counter_argument",
              "field_type": "str",
              "extraction_instructions": "Extract the 'counter_argument' field (str) from the task and the 'task', 'observations', 'proposition', 'critique' values in the 'Already extracted:' context. {{counter_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "proposition",
                "critique"
              ],
              "required": true
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "judge",
              "description": "Counter-argument ready for judgment",
              "priority": 100
            }
          ]
        },
        "judge": {
          "id": "judge",
          "description": "Evaluate the debate exchange and decide next action",
          "purpose": "Determine whether consensus has been reached",
          "extraction_instructions": "",
          "field_extractions": [
            {
              "field_name": "judge_verdict",
              "field_type": "str",
              "extraction_instructions": "Extract the 'judge_verdict' field (str) from the task and the 'task', 'observations', 'proposition', 'critique', 'counter_argument' values in the 'Already extracted:' context. {{verdict_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "proposition",
                "critique",
                "counter_argument"
              ],
              "required": false
            },
            {
              "field_name": "consensus_reached",
              "field_type": "bool",
              "extraction_instructions": "Extract the 'consensus_reached' field (bool) from the task and the 'task', 'observations', 'proposition', 'critique', 'counter_argument', 'current_round', 'debate_rounds' values in the 'Already extracted:' context. {{consensus_instructions}}",
              "context_keys": [
                "task",
                "observations",
                "proposition",
                "critique",
                "counter_argument",
                "current_round",
                "debate_rounds"
              ],
              "required": true
            }
          ],
          "response_instructions": "",
          "transitions": [
            {
              "target_state": "conclude",
              "description": "Consensus reached or max rounds hit",
              "priority": 10,
              "conditions": [
                {
                  "description": "Consensus reached or max rounds hit",
                  "logic": {
                    "or": [
                      {
                        "==": [
                          {
                            "var": "consensus_reached"
                          },
                          true
                        ]
                      },
                      {
                        ">=": [
                          {
                            "var": "current_round"
                          },
                          {
                            "$hole": "max_rounds"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "target_state": "propose",
              "description": "Another round of debate needed",
              "priority": 300
            }
          ]
        },
        "conclude": {
          "id": "conclude",
          "description": "Produce the final answer from the debate",
          "purpose": "Synthesize the debate into a definitive answer",
          "extraction_instructions": "",
          "response_instructions": "Give the final, definitive answer to the task from the debate: state the answer first, then the key arguments from debate_rounds that shaped it.",
          "transitions": []
        }
      },
      "handler_only_keys": [
        "max_iterations_reached",
        "forced_stop_reason",
        "iteration_count",
        "observation_count",
        "refused_actions"
      ]
    },
    "handlers": [
      {
        "handler": "agents.debate_judge",
        "on": "state",
        "states": [
          "judge"
        ]
      },
      {
        "handler": "agents.debate_consensus_reset",
        "on": "entry",
        "states": [
          "propose"
        ]
      },
      {
        "handler": "agents.debate_limiter",
        "on": "state",
        "keys": [
          "should_terminate",
          "consensus_reached"
        ]
      }
    ],
    "options_schema": {
      "type": "object",
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "description": "Round cap: the judge edge to conclude fires at it and the judge handler forces consensus there"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Step ceiling of the run: the iteration limiter forces consensus one step before it"
        }
      }
    },
    "options": {
      "max_rounds": 3,
      "max_iterations": 18
    },
    "run": {
      "agent_type": "debate",
      "success_keys": [
        "proposition"
      ],
      "context_seed": {
        "debate_rounds": [],
        "current_round": 1
      }
    }
  }
}
