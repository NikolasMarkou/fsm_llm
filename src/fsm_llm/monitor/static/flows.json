        {"from": "process_payment", "to": "send_confirmation", "label": "payment ok"},
        {"from": "process_payment", "to": "failed", "label": "payment failed"},
        {"from": "send_confirmation", "to": "completed", "label": "confirmed"}
      ]
    },
    "data_pipeline": {
