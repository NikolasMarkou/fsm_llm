# Nothing reads this file unasked. Load it from Python with fsm_llm.load_env()
# (or fsm_llm.load_env("path/to/.env")), or pass --env-file PATH to fsm-llm.
# A variable already set in the environment is not replaced by this file, except an
# empty or whitespace-only one, which counts as unset. To keep a variable empty on
# purpose, do not name it here.
# No command and no library entry has a built-in model: set LLM_MODEL (here, in the
# environment), pass model=, or give --model. Without one, every entry point (the CLIs,
# fsm-llm-eval, the monitor launch routes) says so and stops. Copy this file to .env
# (gitignored) for a machine of your own and run `make monitor` or `make eval-examples`,
# which pass --env-file .env.
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
